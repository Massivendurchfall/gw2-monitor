<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GW2 Monitor" Width="1000" Height="680" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0E0F14" Foreground="#ECEEF5"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <!-- ============ Colors ============ -->
    <SolidColorBrush x:Key="Surface" Color="#14151C"/>
    <SolidColorBrush x:Key="Card" Color="#1A1C25"/>
    <SolidColorBrush x:Key="Input" Color="#111219"/>
    <SolidColorBrush x:Key="Line" Color="#262938"/>
    <SolidColorBrush x:Key="LineHi" Color="#3A3F55"/>
    <SolidColorBrush x:Key="Text" Color="#ECEEF5"/>
    <SolidColorBrush x:Key="Muted" Color="#8C91A5"/>
    <SolidColorBrush x:Key="Subtle" Color="#5E6377"/>
    <SolidColorBrush x:Key="Accent" Color="#7C5CFF"/>
    <SolidColorBrush x:Key="Good" Color="#34D399"/>
    <SolidColorBrush x:Key="Warn" Color="#FBBF24"/>
    <SolidColorBrush x:Key="Bad" Color="#F87171"/>
    <SolidColorBrush x:Key="Info" Color="#60A5FA"/>
    <SolidColorBrush x:Key="Idle" Color="#6B7085"/>
    <LinearGradientBrush x:Key="LogoGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#7C5CFF" Offset="0"/>
      <GradientStop Color="#22D3EE" Offset="1"/>
    </LinearGradientBrush>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ============ Text ============ -->
    <Style x:Key="Icon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="RowTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="TileLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="TileValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="23"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <Style x:Key="TileSub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Subtle}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- ============ Surfaces ============ -->
    <Style x:Key="CardBox" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Card}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="20,18"/>
    </Style>
    <Style x:Key="Sep" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="{StaticResource Line}"/>
      <Setter Property="Margin" Value="0,10"/>
    </Style>

    <!-- ============ Buttons ============ -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="#232633"/>
      <Setter Property="BorderBrush" Value="#2E3242"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="root">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
              <Border x:Name="ov" Background="#FFFFFF" CornerRadius="8" Opacity="0"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ov" Property="Opacity" Value="0.06"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ov" Property="Opacity" Value="0.12"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="root" Property="Opacity" Value="0.38"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#7C5CFF"/>
      <Setter Property="BorderBrush" Value="#8F74FF"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#3A1E27"/>
      <Setter Property="BorderBrush" Value="#5A2A36"/>
      <Setter Property="Foreground" Value="#FFB8B8"/>
    </Style>
    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="10,0"/>
    </Style>

    <!-- ============ Navigation ============ -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#9AA0B4"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="nav"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bg" Background="Transparent" CornerRadius="8">
              <Grid>
                <Border x:Name="bar" Width="3" Height="16" CornerRadius="2" Background="#7C5CFF"
                        HorizontalAlignment="Left" Opacity="0"/>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                             FontFamily="{StaticResource IconFont}" FontSize="15" Width="20" VerticalAlignment="Center"/>
                  <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#181A23"/>
                <Setter Property="Foreground" Value="#ECEEF5"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#1C1E29"/>
                <Setter TargetName="bar" Property="Opacity" Value="1"/>
                <Setter Property="Foreground" Value="#ECEEF5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ Switch ============ -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="track" Width="40" Height="22" CornerRadius="11" Background="#262938"
                    BorderBrush="#383C50" BorderThickness="1">
              <Ellipse x:Name="knob" Width="14" Height="14" Fill="#9AA0B4" HorizontalAlignment="Left" Margin="3,0,0,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#7C5CFF"/>
                <Setter TargetName="track" Property="BorderBrush" Value="#8F74FF"/>
                <Setter TargetName="knob" Property="Fill" Value="#FFFFFF"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="track" Property="BorderBrush" Value="#4A4F66"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="track" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ Text box ============ -->
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="{StaticResource Input}"/>
      <Setter Property="BorderBrush" Value="#2C3040"/>
      <Setter Property="CaretBrush" Value="#ECEEF5"/>
      <Setter Property="SelectionBrush" Value="#7C5CFF"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
              <Grid>
                <TextBlock x:Name="ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                           Foreground="#565B6E" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                              Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#3A3F55"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#7C5CFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ Dropdown ============ -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="b" Background="#111219" BorderBrush="#2C3040" BorderThickness="1" CornerRadius="8">
              <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="#8C91A5"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#3A3F55"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#7C5CFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Width" Value="180"/>
      <Setter Property="MaxDropDownHeight" Value="280"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid x:Name="root">
              <ToggleButton Style="{StaticResource ComboToggle}" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter IsHitTestVisible="False" Margin="12,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <Popup x:Name="PART_Popup" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                     Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#1C1E28" BorderBrush="#2E3242" BorderThickness="1" CornerRadius="8" Padding="4"
                        MinWidth="{Binding ActualWidth, ElementName=root}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="root" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,7">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="b" Property="Background" Value="#2A2D3C"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="#B9A8FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ Scrollbar ============ -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="t" CornerRadius="3" Background="#2E3242" Margin="2,0"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="t" Property="Background" Value="#41465C"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Style="{StaticResource ThumbStyle}"/>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ Log ============ -->
    <Style x:Key="PlainItem" TargetType="ListBoxItem">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="LogItem">
      <Grid Margin="0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="66"/>
          <ColumnDefinition Width="18"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Time}" Foreground="#5E6377" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                   VerticalAlignment="Top" Margin="0,1,0,0"/>
        <Ellipse Grid.Column="1" Width="7" Height="7" Fill="{Binding Brush}" VerticalAlignment="Top"
                 HorizontalAlignment="Left" Margin="0,6,0,0"/>
        <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap"/>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <!-- ===================================================================== -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="212"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ============ Sidebar ============ -->
    <DockPanel Margin="14,12,14,14">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,0,24">
        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource LogoGradient}">
          <Viewbox Margin="7">
            <Path Data="M2,12 L7,12 L9.6,5.5 L13,17.5 L15.4,10.5 L20,10.5" Stroke="White" StrokeThickness="2.6"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="22" Height="22"/>
          </Viewbox>
        </Border>
        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="GW2 Monitor" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock Text="Watchdog · v2.0" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,1,0,0"/>
        </StackPanel>
      </StackPanel>

      <TextBlock DockPanel.Dock="Bottom" Text="made by tape" FontSize="11" Foreground="#4B5063" Margin="6,10,0,0"/>
      <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" CornerRadius="10" Padding="12,10"
              BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="NavDot" Width="8" Height="8" Fill="#6B7085" VerticalAlignment="Center"/>
            <TextBlock x:Name="NavStatus" Text="Monitoring off" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"/>
          </StackPanel>
          <TextBlock x:Name="NavSub" Text="inactive" FontSize="11" Foreground="{StaticResource Muted}" Margin="16,3,0,0"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Border>

      <StackPanel>
        <RadioButton x:Name="NavDashboard" Style="{StaticResource Nav}" Tag="&#xE80F;" Content="Overview" IsChecked="True"/>
        <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="&#xE713;" Content="Settings"/>
        <RadioButton x:Name="NavDiscord" Style="{StaticResource Nav}" Tag="&#xEA8F;" Content="Discord"/>
        <RadioButton x:Name="NavLog" Style="{StaticResource Nav}" Tag="&#xE81C;" Content="Log"/>
      </StackPanel>
    </DockPanel>

    <!-- ============ Content ============ -->
    <Border Grid.Column="1" Background="{StaticResource Surface}" CornerRadius="14,0,0,0"
            BorderBrush="#202331" BorderThickness="1,1,0,0">
      <Grid>

        <!-- ===================== OVERVIEW ===================== -->
        <Grid x:Name="PageDashboard" Margin="28,24,28,24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Text="Overview" Style="{StaticResource H1}"/>
            <TextBlock Text="Game and monitoring status at a glance." Style="{StaticResource Sub}"/>
          </StackPanel>

          <!-- Status -->
          <Border Grid.Row="1" Style="{StaticResource CardBox}" Margin="0,20,0,0" Padding="22,20">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Width="48" Height="48" VerticalAlignment="Center">
                <Ellipse x:Name="StatusHalo" Fill="#6B7085" Opacity="0.14" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                  </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="#6B7085"/>
              </Grid>
              <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="StatusTitle" Text="Game not running" FontSize="20" FontWeight="SemiBold"/>
                  <Border x:Name="WatchChip" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center"
                          Background="#262938">
                    <TextBlock x:Name="WatchChipText" Text="NOT MONITORED" FontSize="10.5" FontWeight="Bold"
                               Foreground="#8C91A5"/>
                  </Border>
                </StackPanel>
                <TextBlock x:Name="StatusDetail" Text="" Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button x:Name="WatchButton" Grid.Column="2" Style="{StaticResource BtnPrimary}" Height="42"
                      Padding="20,0" MinWidth="210" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="WatchIcon" Style="{StaticResource Icon}" Text="&#xE768;"/>
                  <TextBlock x:Name="WatchText" Text="Start monitoring" Margin="9,0,0,0" FontSize="13.5"/>
                </StackPanel>
              </Button>
            </Grid>
          </Border>

          <!-- Tiles -->
          <UniformGrid Grid.Row="2" Columns="4" Margin="0,14,0,0">
            <Border Style="{StaticResource CardBox}" Margin="0,0,7,0" Padding="18,15">
              <StackPanel>
                <TextBlock Text="GAME UPTIME" Style="{StaticResource TileLabel}"/>
                <TextBlock x:Name="TileUptime" Text="--:--:--" Style="{StaticResource TileValue}"/>
                <TextBlock x:Name="TileUptimeSub" Text="Game not active" Style="{StaticResource TileSub}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBox}" Margin="7,0,7,0" Padding="18,15">
              <StackPanel>
                <TextBlock Text="NEXT RESTART" Style="{StaticResource TileLabel}"/>
                <TextBlock x:Name="TileNext" Text="–" Style="{StaticResource TileValue}"/>
                <TextBlock x:Name="TileNextSub" Text="" Style="{StaticResource TileSub}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBox}" Margin="7,0,7,0" Padding="18,15">
              <StackPanel>
                <TextBlock Text="RESTARTS" Style="{StaticResource TileLabel}"/>
                <TextBlock x:Name="TileRestarts" Text="0" Style="{StaticResource TileValue}"/>
                <TextBlock x:Name="TileRestartsSub" Text="since app start" Style="{StaticResource TileSub}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBox}" Margin="7,0,0,0" Padding="18,15">
              <StackPanel>
                <TextBlock Text="CRASHES" Style="{StaticResource TileLabel}"/>
                <TextBlock x:Name="TileCrashes" Text="0" Style="{StaticResource TileValue}"/>
                <TextBlock x:Name="TileCrashesSub" Text="since app start" Style="{StaticResource TileSub}"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <!-- Actions -->
          <UniformGrid Grid.Row="3" Columns="4" Margin="0,14,0,0">
            <Button x:Name="LaunchButton" Style="{StaticResource Btn}" Margin="0,0,7,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;"/>
                <TextBlock Text="Launch game" Margin="8,0,0,0"/>
              </StackPanel>
            </Button>
            <Button x:Name="RestartButton" Style="{StaticResource Btn}" Margin="7,0,7,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;"/>
                <TextBlock x:Name="RestartText" Text="Restart game" Margin="8,0,0,0"/>
              </StackPanel>
            </Button>
            <Button x:Name="HideButton" Style="{StaticResource Btn}" Margin="7,0,7,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="HideIcon" Style="{StaticResource Icon}" Text="&#xED1A;"/>
                <TextBlock x:Name="HideText" Text="Hide window" Margin="8,0,0,0"/>
              </StackPanel>
            </Button>
            <Button x:Name="TrayButton" Style="{StaticResource Btn}" Margin="7,0,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE921;"/>
                <TextBlock Text="To tray" Margin="8,0,0,0"/>
              </StackPanel>
            </Button>
          </UniformGrid>

          <!-- Recent events -->
          <Border Grid.Row="4" Style="{StaticResource CardBox}" Margin="0,14,0,0" Padding="20,14,12,12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <DockPanel>
                <Button x:Name="ShowLogButton" DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="Show all  →"/>
                <TextBlock Text="Recent events" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBlock x:Name="RecentEmpty" Grid.Row="1" Text="No events yet." Foreground="{StaticResource Subtle}"
                         Margin="0,10,0,0"/>
              <ItemsControl x:Name="RecentList" Grid.Row="1" Margin="0,6,8,0" ItemTemplate="{StaticResource LogItem}"
                            ClipToBounds="True"/>
            </Grid>
          </Border>
        </Grid>

        <!-- ===================== SETTINGS ===================== -->
        <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="28,24,22,28">
            <TextBlock Text="Settings" Style="{StaticResource H1}"/>
            <TextBlock Text="Changes apply immediately and are saved automatically." Style="{StaticResource Sub}"/>

            <!-- Game -->
            <Border Style="{StaticResource CardBox}" Margin="0,20,0,0">
              <StackPanel>
                <TextBlock Text="Game" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="GAME PATH" Style="{StaticResource FieldLabel}" Margin="0,6,0,6"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="GamePath" Tag="…\GW2.Main_Win64_Retail.exe  or  steam://rungameid/…"/>
                  <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource Btn}" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE838;"/>
                      <TextBlock Text="Browse" Margin="8,0,0,0"/>
                    </StackPanel>
                  </Button>
                </Grid>
                <TextBlock x:Name="PathCheck" Text="" FontSize="12" Margin="2,7,0,0"/>

                <TextBlock Text="PROCESS NAME" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                <TextBox x:Name="ProcessName" Tag="GW2.Main_Win64_Retail.exe"/>
                <TextBlock Text="Set automatically when you browse. Only change it if the game is launched via a link."
                           Style="{StaticResource Hint}" Margin="2,7,0,0"/>
              </StackPanel>
            </Border>

            <!-- Automation -->
            <Border Style="{StaticResource CardBox}" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="Automation" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="Applies while monitoring is active." Style="{StaticResource Hint}" Margin="0,-4,0,10"/>

                <Grid MinHeight="50">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Restart when the game exits" Style="{StaticResource RowTitle}"/>
                    <TextBlock Text="“Only on crash” checks the exit code – closing the game normally keeps it closed." Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <ComboBox x:Name="RestartPolicy" Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>
                <Border Style="{StaticResource Sep}"/>

                <Grid MinHeight="50">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Scheduled restart" Style="{StaticResource RowTitle}"/>
                    <TextBlock Text="Cleanly restarts the game after a fixed uptime." Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <ComboBox x:Name="TimedHours" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"/>
                  <CheckBox x:Name="TimedRestart" Grid.Column="2" Style="{StaticResource Switch}"/>
                </Grid>
                <Border Style="{StaticResource Sep}"/>

                <Grid MinHeight="50">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Detect freezes and restart" Style="{StaticResource RowTitle}"/>
                    <TextBlock Text="If the game window stops responding for this long, the game is killed and restarted." Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <ComboBox x:Name="FreezeSeconds" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"/>
                  <CheckBox x:Name="FreezeDetection" Grid.Column="2" Style="{StaticResource Switch}"/>
                </Grid>
                <Border Style="{StaticResource Sep}"/>

                <Grid MinHeight="50">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Hide game window automatically" Style="{StaticResource RowTitle}"/>
                    <TextBlock Text="The game keeps running invisibly in the background – also after every restart." Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <CheckBox x:Name="StartHidden" Grid.Column="1" Style="{StaticResource Switch}"/>
                </Grid>
                <Border Style="{StaticResource Sep}"/>

                <Grid MinHeight="50">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Launch the game when monitoring starts" Style="{StaticResource RowTitle}"/>
                    <TextBlock Text="If the game isn’t running yet, it is launched right away." Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <CheckBox x:Name="LaunchOnArm" Grid.Column="1" Style="{StaticResource Switch}"/>
                </Grid>
                <Border Style="{StaticResource Sep}"/>

                <Grid MinHeight="50">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Hotkey Ctrl + Alt + H" Style="{StaticResource RowTitle}"/>
                    <TextBlock Text="Hide and show the game window from anywhere." Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <CheckBox x:Name="Hotkey" Grid.Column="1" Style="{StaticResource Switch}"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- App -->
            <Border Style="{StaticResource CardBox}" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="App" Style="{StaticResource CardTitle}"/>

                <Grid MinHeight="50">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}"/>
                    <TextBlock Text="Starts quietly in the tray when you sign in." Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <CheckBox x:Name="StartWithWindows" Grid.Column="1" Style="{StaticResource Switch}"/>
                </Grid>
                <Border Style="{StaticResource Sep}"/>

                <Grid MinHeight="50">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Start monitoring when the app starts" Style="{StaticResource RowTitle}"/>
                    <TextBlock Text="Together with “Start with Windows”, everything resumes on its own after a PC reboot." Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <CheckBox x:Name="ArmOnLaunch" Grid.Column="1" Style="{StaticResource Switch}"/>
                </Grid>
                <Border Style="{StaticResource Sep}"/>

                <Grid MinHeight="50">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Close button minimizes to tray" Style="{StaticResource RowTitle}"/>
                    <TextBlock Text="To exit, right-click the tray icon." Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <CheckBox x:Name="CloseToTray" Grid.Column="1" Style="{StaticResource Switch}"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Advanced -->
            <Border Style="{StaticResource CardBox}" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="Advanced" Style="{StaticResource CardTitle}"/>

                <Grid MinHeight="50">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Check interval" Style="{StaticResource RowTitle}"/>
                    <TextBlock Text="Crashes are detected instantly regardless." Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <ComboBox x:Name="PollSeconds" Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>
                <Border Style="{StaticResource Sep}"/>

                <Grid MinHeight="50">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Pause before restart" Style="{StaticResource RowTitle}"/>
                    <TextBlock Text="Wait time between closing and launching again." Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <ComboBox x:Name="Cooldown" Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>
                <Border Style="{StaticResource Sep}"/>

                <Grid MinHeight="50">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Max. automatic restarts" Style="{StaticResource RowTitle}"/>
                    <TextBlock Text="Crash-loop protection: beyond this, no more automatic restarts." Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <ComboBox x:Name="MaxRestarts" Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>

                <Button x:Name="OpenConfigButton" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,14,0,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE838;"/>
                    <TextBlock Text="Open settings folder" Margin="8,0,0,0"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ===================== DISCORD ===================== -->
        <ScrollViewer x:Name="PageDiscord" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="28,24,22,28">
            <TextBlock Text="Discord" Style="{StaticResource H1}"/>
            <TextBlock Text="Webhook notifications – sent only while monitoring is active." Style="{StaticResource Sub}"/>

            <Border Style="{StaticResource CardBox}" Margin="0,20,0,0">
              <StackPanel>
                <TextBlock Text="Connection" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="WEBHOOK URL" Style="{StaticResource FieldLabel}" Margin="0,6,0,6"/>
                <TextBox x:Name="WebhookUrl" Tag="https://discord.com/api/webhooks/…"/>
                <TextBlock x:Name="WebhookHint" Text="" FontSize="12" Margin="2,7,0,0"/>

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="DISCORD USER ID (FOR PINGS)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UserId" Tag="e.g. 123456789012345678"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="NAME OF THIS PC (OPTIONAL)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="InstanceName" Tag="e.g. Farm PC 1"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="Get your user ID by right-clicking your name → “Copy User ID” (enable Developer Mode in Discord). The PC name appears in every message – handy with several PCs."
                           Style="{StaticResource Hint}" Margin="2,8,0,0"/>

                <Border Style="{StaticResource Sep}" Margin="0,14,0,10"/>
                <Grid MinHeight="44">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Ping only on problems" Style="{StaticResource RowTitle}"/>
                    <TextBlock Text="Mentions you only on crashes, freezes or launch failures – everything else arrives silently." Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <CheckBox x:Name="PingOnlyOnProblems" Grid.Column="1" Style="{StaticResource Switch}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button x:Name="TestButton" Style="{StaticResource BtnPrimary}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE724;"/>
                      <TextBlock Text="Send test message" Margin="8,0,0,0"/>
                    </StackPanel>
                  </Button>
                  <TextBlock x:Name="TestResult" Text="" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBox}" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="Events" Style="{StaticResource CardTitle}"/>

                <Grid MinHeight="44">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Crash / game closed" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                  <CheckBox x:Name="NotifyGameClosed" Grid.Column="1" Style="{StaticResource Switch}"/>
                </Grid>
                <Border Style="{StaticResource Sep}" Margin="0,4"/>
                <Grid MinHeight="44">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Game not responding (freeze)" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                  <CheckBox x:Name="NotifyFreeze" Grid.Column="1" Style="{StaticResource Switch}"/>
                </Grid>
                <Border Style="{StaticResource Sep}" Margin="0,4"/>
                <Grid MinHeight="44">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Restarts" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                  <CheckBox x:Name="NotifyRestart" Grid.Column="1" Style="{StaticResource Switch}"/>
                </Grid>
                <Border Style="{StaticResource Sep}" Margin="0,4"/>
                <Grid MinHeight="44">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Game started" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                  <CheckBox x:Name="NotifyGameStarted" Grid.Column="1" Style="{StaticResource Switch}"/>
                </Grid>
                <Border Style="{StaticResource Sep}" Margin="0,4"/>
                <Grid MinHeight="44">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Monitoring started / stopped" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                  <CheckBox x:Name="NotifyWatchdog" Grid.Column="1" Style="{StaticResource Switch}"/>
                </Grid>
                <Border Style="{StaticResource Sep}" Margin="0,4"/>
                <Grid MinHeight="44">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Window hidden / shown" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                  <CheckBox x:Name="NotifyHideShow" Grid.Column="1" Style="{StaticResource Switch}"/>
                </Grid>
                <Border Style="{StaticResource Sep}" Margin="0,4"/>
                <Grid MinHeight="50">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Periodic status report" Style="{StaticResource RowTitle}"/>
                    <TextBlock Text="Sign of life with uptime, restarts and crashes." Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <ComboBox x:Name="HeartbeatHours" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"/>
                  <CheckBox x:Name="NotifyHeartbeat" Grid.Column="2" Style="{StaticResource Switch}"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ===================== LOG ===================== -->
        <Grid x:Name="PageLog" Visibility="Collapsed" Margin="28,24,28,24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="OpenLogButton" Style="{StaticResource Btn}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE838;"/>
                  <TextBlock Text="Log file" Margin="8,0,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="ClearLogButton" Style="{StaticResource Btn}" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;"/>
                  <TextBlock Text="Clear" Margin="8,0,0,0"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Log" Style="{StaticResource H1}"/>
              <TextBlock Text="All events of this session, newest first." Style="{StaticResource Sub}"/>
            </StackPanel>
          </DockPanel>
          <Border Grid.Row="1" Style="{StaticResource CardBox}" Margin="0,20,0,0" Padding="20,12,8,12">
            <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                     ItemTemplate="{StaticResource LogItem}" ItemContainerStyle="{StaticResource PlainItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"/>
          </Border>
        </Grid>

      </Grid>
    </Border>
  </Grid>
</Window>
